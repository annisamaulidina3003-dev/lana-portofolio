# ─────────────────────────────────────────────────────────────────────────────
# Salin berkas ini menjadi `.env.local` (TIDAK ikut Git) lalu isi nilainya.
#   cp .env.example .env.local
#
# Nilai ada di Supabase Dashboard → Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

# URL proyek, mis. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Kunci PUBLIK: "anon" (JWT) atau "publishable" (sb_publishable_…).
# Aman berada di browser karena akses data dijaga oleh RLS di database.
#
# ⚠ JANGAN PERNAH mengisi service_role / secret key (sb_secret_…) di sini atau di
#   variabel lain berawalan VITE_ — semua variabel VITE_ ikut terbundel ke browser
#   dan kunci itu melewati seluruh RLS. Aplikasi menolak kunci semacam itu.
VITE_SUPABASE_ANON_KEY=

# Sumber konten halaman publik (Phase 07C):
#   (kosong / supabase) → database Supabase — DEFAULT bila dua variabel di atas valid
#   local               → data di src/data/* (pengembangan UI tanpa backend; tanpa jaringan)
# Bila Supabase belum dikonfigurasi, situs otomatis memakai data lokal dan menulis peringatan di konsol.
VITE_DATA_SOURCE=supabase
